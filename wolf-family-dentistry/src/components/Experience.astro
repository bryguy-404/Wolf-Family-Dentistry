---
import SourceCopy from './SourceCopy.astro';
---
<section class="section-space bg-ivory">
  <div class="page-shell split-layout">
    <div>
      <SourceCopy page="home" block={12} class="section-copy" />
      <div class="mt-9 rounded-[28px] bg-plum p-7 text-white sm:p-9">
        <SourceCopy page="home" block={13} class="form-promo" />
      </div>
    </div>
    <img src="/images/practice-interior.jpg" width="900" height="500" alt="Wolf Family Dentistry office building" loading="lazy" class="aspect-[4/5] w-full rounded-[32px] object-cover shadow-soft" />
  </div>
</section>
